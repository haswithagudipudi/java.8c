import javafx.application.Application;
import javafx.geometry.Insets;
import javafx.geometry.Pos;
import javafx.scene.Scene;
import javafx.scene.control.*;
import javafx.scene.layout.GridPane;
import javafx.scene.layout.VBox;
import javafx.stage.Stage;

public class TipCalculator extends Application {

    @Override
    public void start(Stage stage) {

        // Labels
        Label billLabel = new Label("Bill Amount:");
        Label tipLabel = new Label("Tip Percentage:");
        Label peopleLabel = new Label("Number of People:");
        Label tipAmountLabel = new Label("Tip Amount: $0.00");
        Label totalLabel = new Label("Total Amount: $0.00");
        Label perPersonLabel = new Label("Per Person: $0.00");

        // Text field for bill amount
        TextField billField = new TextField();
        billField.setPromptText("Enter bill amount");

        // Slider for tip percentage
        Slider tipSlider = new Slider(0, 30, 15);
        tipSlider.setMajorTickUnit(5);
        tipSlider.setMinorTickCount(0);
        tipSlider.setBlockIncrement(5);
        tipSlider.setShowTickMarks(true);
        tipSlider.setShowTickLabels(true);

        // ComboBox for number of people
        ComboBox<Integer> peopleComboBox = new ComboBox<>();
        for (int i = 1; i <= 10; i++) {
            peopleComboBox.getItems().add(i);
        }
        peopleComboBox.setValue(1);

        // CheckBox
        CheckBox splitCheckBox = new CheckBox("Split bill");

        // Calculate button
        Button calculateButton = new Button("Calculate Tip");

        // Event handler for the button
        calculateButton.setOnAction(event -> {

            try {
                double bill = Double.parseDouble(billField.getText());

                if (bill < 0) {
                    throw new NumberFormatException();
                }

                double tipPercentage = tipSlider.getValue();
                int people = peopleComboBox.getValue();

                double tipAmount = bill * tipPercentage / 100;
                double totalAmount = bill + tipAmount;
                double perPerson = totalAmount / people;

                tipAmountLabel.setText(
                        String.format("Tip Amount: $%.2f", tipAmount)
                );

                totalLabel.setText(
                        String.format("Total Amount: $%.2f", totalAmount)
                );

                if (splitCheckBox.isSelected()) {
                    perPersonLabel.setText(
                            String.format("Per Person: $%.2f", perPerson)
                    );
                } else {
                    perPersonLabel.setText(
                            String.format("Per Person: $%.2f", totalAmount)
                    );
                }

            } catch (NumberFormatException e) {

                Alert alert = new Alert(Alert.AlertType.ERROR);
                alert.setTitle("Invalid Input");
                alert.setHeaderText(null);
                alert.setContentText(
                        "Please enter a valid bill amount."
                );
                alert.showAndWait();
            }
        });

        // GridPane for form layout
        GridPane grid = new GridPane();
        grid.setHgap(10);
        grid.setVgap(15);
        grid.setPadding(new Insets(20));

        grid.add(billLabel, 0, 0);
        grid.add(billField, 1, 0);

        grid.add(tipLabel, 0, 1);
        grid.add(tipSlider, 1, 1);

        grid.add(peopleLabel, 0, 2);
        grid.add(peopleComboBox, 1, 2);

        grid.add(splitCheckBox, 1, 3);
        grid.add(calculateButton, 1, 4);

        grid.add(tipAmountLabel, 0, 5, 2, 1);
        grid.add(totalLabel, 0, 6, 2, 1);
        grid.add(perPersonLabel, 0, 7, 2, 1);

        // Main layout
        VBox root = new VBox(10);
        root.setAlignment(Pos.CENTER);
        root.getChildren().add(grid);

        // Scene
        Scene scene = new Scene(root, 450, 400);

        stage.setTitle("Tip Calculator");
        stage.setScene(scene);
        stage.show();
    }

    public static void main(String[] args) {
        launch(args);
    }
}
